env: "development"

# Bootstrap rules:
# - the backend always reads this file on startup
# - local go run does not auto-load .env
# - runtime backend selection comes only from forward_runtime below

server:
  host: "0.0.0.0"
  port: 8080
  mode: "release"
  read_timeout: 30
  write_timeout: 30

frontend:
  enable: true
  port: 3000
  path: "web/public"

database:
  driver: "sqlite"
  database: "config/data/v2board.db"
  log_level: "info"
  # host: "127.0.0.1"
  # port: 5432
  # username: "postgres"
  # password: ""
  # max_idle_conns: 10
  # max_open_conns: 100
  # conn_max_lifetime: 3600

cache:
  driver: "memory"
  # redis_host: "127.0.0.1"
  # redis_port: 6379
  # redis_password: ""
  # redis_db: 0

log:
  level: "info"
  output: "stdout"
  file_path: "./logs/v2board.log"
  max_size: 100
  max_backups: 30
  max_age: 7

jwt:
  secret: "your-jwt-secret-key-change-in-production"
  expire: 86400

app:
  name: "V2Board"
  version: "2.0.1"
  api_token: ""
  traffic_log_enable: true
  subscribe_path: "s"

# Canonical forward runtime config for Windows/Linux/local binary/Docker.
# Startup order:
# 1. read forward_runtime from config.yaml
# 2. normalize relative runtime paths
# 3. persist the runtime snapshot into v2_system_config
forward_runtime:
  # Optional compatibility switch:
  # - true  => backend forced to gost
  # - false => backend forced to iptables_ansible
  # If omitted, backend below is used directly.
  # nodex_mode: true

  # Choose one backend:
  # - gost              => NodeX mode, stateful runtime
  # - iptables_ansible  => local ansible/iptables mode, stateless runtime
  backend: "gost"

  # NodeX / gost runtime.
  nodex:
    base_url: "http://127.0.0.1:18081"
    token: "replace-with-shared-token"
    timeout_seconds: 15

  # Local ansible execution runtime.
  # Relative paths are resolved from config.yaml/project location at startup.
  iptables_ansible:
    inventory: "config/deploy/ansible/inventory.ini"
    apply_playbook: "config/deploy/ansible/playbooks/forward_apply.yml"
    remove_playbook: "config/deploy/ansible/playbooks/forward_remove.yml"
    become: false
    extra_vars: {}
    command: ""
    working_dir: "config/deploy/ansible"
    target_pattern: "{{node.host}}"
    environment:
      ANSIBLE_CONFIG: "config/deploy/ansible/ansible.cfg"
    timeout_seconds: 120

  # Optional local background worker tuning.
  # Duration values use Go syntax such as 5s, 30s, 2m.
  jobs:
    poll_interval: "5s"
    idle_poll_interval: "30s"
    error_log_interval: "1m"
    batch_size: 10
    timeout_seconds: 120

  gost_stats:
    poll_interval: "30s"
    idle_poll_interval: "2m"
    error_log_interval: "5m"

admin:
  email: "v2board@anixops.com"
  password: ""

tls:
  enable: false
  cert_file: ""
  key_file: ""
  domain: ""
