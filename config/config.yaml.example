# V2Board Go Backend Configuration

server:
  host: "0.0.0.0"
  port: 8080
  mode: "release"  # debug, release, test
  read_timeout: 30
  write_timeout: 30

# 数据库配置
# 支持 sqlite (默认) 和 postgres
database:
  driver: "sqlite"             # sqlite 或 postgres
  database: "data/v2board.db"  # SQLite: 文件路径, PostgreSQL: 数据库名
  log_level: "info"            # silent, error, warn, info
  # PostgreSQL 专用配置 (使用 SQLite 时可忽略)
  # host: "127.0.0.1"
  # port: 5432
  # username: "postgres"
  # password: ""
  # max_idle_conns: 10
  # max_open_conns: 100
  # conn_max_lifetime: 3600

# 缓存配置
# 默认使用内存缓存，无需任何外部依赖
cache:
  driver: "memory"  # memory (默认，推荐) 或 redis
  # Redis 专用配置 (使用 memory 时可忽略)
  # redis_host: "127.0.0.1"
  # redis_port: 6379
  # redis_password: ""
  # redis_db: 0

log:
  level: "info"  # debug, info, warn, error
  output: "stdout"  # stdout, file
  file_path: "./logs/v2board.log"
  max_size: 100  # MB
  max_backups: 30
  max_age: 7  # days

jwt:
  secret: "your-jwt-secret-key-change-in-production"
  expire: 86400  # seconds

app:
  name: "V2Board"
  version: "2.0.0"
  api_token: ""  # Global API token for node communication
  traffic_log_enable: true
  subscribe_path: "s"

admin:
  email: "v2board@anixops.com"
  password: ""