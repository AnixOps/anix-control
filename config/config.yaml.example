# AnixOps Control configuration (/etc/anix-control/config.yaml).
#
# An ordinary install sets one key: the panel's domain name. Point its A
# (and AAAA) record at this machine without a CDN proxy, and keep ports 80
# and 443 free: Control obtains and renews its certificate itself.
#
# Every other key has a built-in value. The keys, their defaults and their
# ANIX_CONTROL_* variables: docs/reference/configuration.md and
# `anix-control -print-env`. The file holds no secret: the root key lives in
# the data directory (data_dir, /var/lib/anix-control/root.key).
#
# Behind a reverse proxy or a CDN that terminates TLS:
#   tls:
#     mode: external
#     cert_file: /etc/anix-control/tls/fullchain.pem   # the nodes' gRPC certificate
#     key_file: /etc/anix-control/tls/privkey.pem
#   listen: 127.0.0.1:8080
#   grpc:
#     public_name: grpc.example.com   # only when domain sits behind a CDN
#
# Check a file with `anix-control config check --file <path>`; turn a 4.x
# file into this form with `anix-control config rewrite --in <old> --out <new>`.
domain: panel.example.com
