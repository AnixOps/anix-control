    "safe_default_templates": [
      {
        "path": "config/config.yaml.example",
        "plugins": {
          "control_execution_enabled": false,
          "dispatch_enabled": false,
          "topology_execution_enabled": false
        }
      },
      {
        "path": "config/config.prod.yaml",
        "plugins": {
          "control_execution_enabled": false,
          "dispatch_enabled": false,
          "topology_execution_enabled": false
        }
      }
    ],
