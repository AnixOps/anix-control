# Non-secret settings for docker-compose.prod.yml. Copy to control.env next to
# the Compose file and edit. Secrets (jwt secret, database password, the CA
# key) are files under secrets/, passed as ANIX_CONTROL_*_FILE by the Compose
# file; init-secrets.sh creates them (secrets.README.md). Control adopts the
# CA key as its root key (root.key in the control-data volume).
# The operator variables: docker run --rm "$ANIX_CONTROL_IMAGE" -print-env.
# Most variables below are deprecated keys Control still reads until the
# container files go (docs/reference/configuration.md lists them).

# External PostgreSQL. host.docker.internal is the Docker host; PostgreSQL
# there must listen on the Docker bridge address (listen_addresses) and allow
# the bridge network in pg_hba.conf with password authentication.
ANIX_CONTROL_DATABASE_HOST=host.docker.internal
ANIX_CONTROL_DATABASE_PORT=5432
ANIX_CONTROL_DATABASE_USERNAME=anix_control
ANIX_CONTROL_DATABASE_DATABASE=anix_control
# disable | require | verify-full (managed databases usually need require+)
ANIX_CONTROL_DATABASE_SSLMODE=disable
ANIX_CONTROL_DATABASE_TIMEZONE=Asia/Shanghai

# Business-day boundaries (traffic resets) follow the container time zone.
TZ=Asia/Shanghai

# First administrator, created on an empty database. An empty database needs
# ANIX_CONTROL_ADMIN_PASSWORD (or ANIX_CONTROL_ADMIN_PASSWORD_FILE) set before the
# first start; Control refuses to start without it and never prints a password.
ANIX_CONTROL_ADMIN_EMAIL=admin@example.com

# Reverse proxies (IPs or CIDRs, comma-separated) whose X-Forwarded-For,
# X-Forwarded-Proto and X-Forwarded-Host are honoured; from any other peer
# they are ignored. docker-compose.prod.yml publishes Control on 127.0.0.1, so
# a proxy on this host reaches it through Docker's bridge gateway (172.16.0.0/12
# covers it; narrow it to the network's gateway, e.g. 172.18.0.1, from
# `docker network inspect anix-control_default`). A proxy container on the same
# network is reached at its container address. If you publish Control on a
# public address (ANIX_CONTROL_BIND=0.0.0.0) without a proxy, set this to
# 127.0.0.1/32,::1/128. docs/DEPLOYMENT.md "Reverse proxies".
ANIX_CONTROL_SERVER_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# Logs: text (default) or json.
ANIX_CONTROL_LOG_FORMAT=text

# Node-facing gRPC (publish ANIX_CONTROL_GRPC_BIND in the Compose .env too).
# `init-secrets.sh --grpc-name <host>` (with a publicly trusted certificate)
# appends ANIX_CONTROL_GRPC_ENABLED, the TLS files under
# /run/anix-control/tls and ANIX_CONTROL_AGENT_INSTALL_GRPC_TARGET here.
# ANIX_CONTROL_GRPC_ENABLED=true
# ANIX_CONTROL_GRPC_API_TOKEN_FILE=/run/secrets/grpc_api_token

# AnixOps Agent client certificates are required: only enrolled agents
# connect, over gRPC with TLS (above) and the built-in CA, whose key is the
# root key.

# Forward runtime (see docs/reference/configuration.md). Values here are copied
# into v2_system_config on every start unless an operator changed them there.
# ANIX_CONTROL_FORWARD_RUNTIME_BACKEND=nftables_ansible
