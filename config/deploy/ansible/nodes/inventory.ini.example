# Password login:
# kfc-jp ansible_host=104.251.233.29 ansible_port=22 ansible_user=root ansible_ssh_pass=changeme node_id=50 v2bx_arch=amd64
#
# Private key login:
# oracle-arm-jp ansible_host=203.0.113.10 ansible_port=22 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/oracle-arm.key node_id=101 v2bx_arch=arm64
