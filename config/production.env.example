# Copy to config/production.env, replace every REPLACE value, and keep the file
# out of version control. Application settings and notification credentials stay
# in config/config.yaml; these values configure only the Compose infrastructure.

DOCKER_IMAGE=anixops/anix-control:v4.0.0@sha256:REPLACE_WITH_RELEASE_DIGEST
POSTGRES_IMAGE=postgres:16-alpine@sha256:REPLACE_WITH_PINNED_DIGEST
NGINX_IMAGE=nginx:alpine@sha256:REPLACE_WITH_PINNED_DIGEST
PROMETHEUS_IMAGE=prom/prometheus:v3.0.0@sha256:REPLACE_WITH_PINNED_DIGEST
GRAFANA_IMAGE=grafana/grafana:11.0.0@sha256:REPLACE_WITH_PINNED_DIGEST

# These values must exactly match database values in config/config.yaml.
DB_USER=anix_control
DB_PASSWORD=REPLACE_WITH_THE_SAME_POSTGRES_PASSWORD
DB_NAME=anix_control
TZ=Asia/Shanghai
PANEL_API_PORT=8080
PANEL_FRONTEND_PORT=3000
PANEL_GRPC_BIND=127.0.0.1
PANEL_GRPC_PORT=50051
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Optional monitoring profiles.
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
GRAFANA_PORT=3001
