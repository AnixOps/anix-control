# V2Board AnixOps production environment example

# Base
TZ=Asia/Shanghai
VERSION=latest
GIN_MODE=release
PANEL_FRONTEND_PORT=3000
PANEL_API_PORT=8080
PANEL_GRPC_PORT=50051
GRAFANA_PORT=3001
ANSIBLE_HOST_KEY_CHECKING=False
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Database
DB_USER=v2board
DB_PASSWORD=your_secure_db_password_here
DB_NAME=v2board

# Redis
REDIS_PASSWORD=your_secure_redis_password_here

# Application
JWT_SECRET=your_jwt_secret_at_least_32_chars_here
API_TOKEN=your_api_token_for_node_communication
FORWARD_RUNTIME_BACKEND=gost
FORWARD_RUNTIME_ANSIBLE_CONFIG_JSON={"inventory":"/app/config/deploy/ansible/inventory.ini","playbookApply":"/app/config/deploy/ansible/playbooks/forward_apply.yml","playbookRemove":"/app/config/deploy/ansible/playbooks/forward_remove.yml","workingDir":"/app/config/deploy/ansible","targetPattern":"{{node.host}}","timeoutSeconds":120,"environment":{"ANSIBLE_CONFIG":"/app/config/deploy/ansible/ansible.cfg"}}
FORWARD_RUNTIME_ANSIBLE_INVENTORY=
FORWARD_RUNTIME_ANSIBLE_BECOME=
FORWARD_RUNTIME_ANSIBLE_HOST_ALIAS=
FORWARD_RUNTIME_ANSIBLE_HOST=
FORWARD_RUNTIME_ANSIBLE_PORT=22
FORWARD_RUNTIME_ANSIBLE_USER=root
FORWARD_RUNTIME_ANSIBLE_PASSWORD=
FORWARD_RUNTIME_ANSIBLE_BECOME_PASSWORD=

# Docker image tag for local builds
DOCKER_IMAGE=v2board:latest

# Grafana
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=your_grafana_password_here

# Optional domain metadata
DOMAIN=panel.example.com
EMAIL=admin@example.com
