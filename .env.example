# V2Board AnixOps 生产环境配置
# 复制此文件为 .env 并填写实际值

# ========== 基础配置 ==========
TZ=Asia/Shanghai
VERSION=latest

# ========== 数据库配置 ==========
DB_USER=v2board
DB_PASSWORD=your_secure_db_password_here
DB_NAME=v2board

# ========== Redis 配置 ==========
REDIS_PASSWORD=your_secure_redis_password_here

# ========== 应用配置 ==========
JWT_SECRET=your_jwt_secret_at_least_32_chars_here
API_TOKEN=your_api_token_for_node_communication

# ========== Docker 配置 ==========
# 如果使用 Docker Hub，填写用户名
DOCKER_REGISTRY=

# ========== Grafana 配置 ==========
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=your_grafana_password_here

# ========== 域名配置 ==========
# 用于 Let's Encrypt 证书
DOMAIN=panel.example.com
EMAIL=admin@example.com