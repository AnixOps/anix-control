# Docker Compose substitution variables for docker-compose.prod.yml. Copy to
# .env next to the Compose file. Control's own settings live in control.env
# (config/deploy/compose/control.env.example) and secrets/.

# Pin the image by digest from the release docker-image.txt.
ANIX_CONTROL_IMAGE=ghcr.io/anixops/anix-control@sha256:<digest>

# Host addresses the ports are published on. Keep 127.0.0.1 behind a reverse
# proxy on the same host (config/deploy/examples/nginx/anix-control.conf).
ANIX_CONTROL_BIND=127.0.0.1
ANIX_CONTROL_API_PORT=8080
ANIX_CONTROL_UI_PORT=3000
# Nodes connect to gRPC directly: bind a reachable address when enabled.
ANIX_CONTROL_GRPC_BIND=127.0.0.1
ANIX_CONTROL_GRPC_PORT=50051

# Optional overrides.
# ANIX_CONTROL_ENV_FILE=control.env
# ANIX_CONTROL_SECRETS_DIR=./secrets
