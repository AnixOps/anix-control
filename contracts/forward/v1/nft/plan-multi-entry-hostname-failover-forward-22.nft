#!/usr/sbin/nft -f
# Rendered by sdk/forward/driver/nftables (anixops forward driver v1); do not edit.
# One transaction that touches table inet anixops_fwd only: declare every
# object, flush the rules and the balancing and admission elements, then add
# them again. Counters, quotas and connection counts keep their values.
# Apply checks the table's ownership comment before running it, and deletes
# the objects of removed hops after reading their counters (F2c).

table inet anixops_fwd {
	comment "anixops-forward-driver v1"
	counter r_01JF1D000000000000000000D1_h0_up {
	}
	counter r_01JF1D000000000000000000D1_h0_down {
	}
	set r_01JF1D000000000000000000D1_h0_conns {
		type mark
		flags dynamic
	}
	map r_01JF1D000000000000000000D1_h0_lb4 {
		type mark : ipv4_addr . inet_service
		flags interval
	}
	chain r_01JF1D000000000000000000D1_h0_dnat {
	}
	chain r_01JF1D000000000000000000D1_h0_acct {
	}
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
	}
	chain forward {
		type filter hook forward priority filter; policy accept;
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
	}
}

flush table inet anixops_fwd
flush map inet anixops_fwd r_01JF1D000000000000000000D1_h0_lb4

table inet anixops_fwd {
	map r_01JF1D000000000000000000D1_h0_lb4 {
		type mark : ipv4_addr . inet_service
		flags interval
		elements = {
			0-127 : 203.0.113.71 . 30000,
		}
	}
	chain r_01JF1D000000000000000000D1_h0_dnat {
		ct mark set ct mark and 0xf000ffff or 0x00010000
		meta nfproto ipv4 meta l4proto { tcp, udp } dnat ip to numgen inc mod 128 map @r_01JF1D000000000000000000D1_h0_lb4
		drop
	}
	chain r_01JF1D000000000000000000D1_h0_acct {
		ct state new add @r_01JF1D000000000000000000D1_h0_conns { ct mark ct count over 100 } reject
		ct direction original counter name "r_01JF1D000000000000000000D1_h0_up" meta mark set meta mark and 0xf000fffe or 0x00010000
		ct direction reply counter name "r_01JF1D000000000000000000D1_h0_down" meta mark set meta mark and 0xf000fffe or 0x00010001
	}
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		meta l4proto { tcp, udp } th dport 40102 fib daddr type local goto r_01JF1D000000000000000000D1_h0_dnat
	}
	chain forward {
		type filter hook forward priority filter; policy accept;
		ct mark and 0x0fff0000 vmap {
			0x00010000 : jump r_01JF1D000000000000000000D1_h0_acct,
		}
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ct mark and 0x0fff0000 {
			0x00010000,
		} masquerade
	}
}
