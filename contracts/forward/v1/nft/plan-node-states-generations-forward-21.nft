#!/usr/sbin/nft -f
# Rendered by sdk/forward/driver/nftables (anixops forward driver v1); do not edit.
# One transaction that touches table inet anixops_fwd only: declare every
# object, flush the rules and the balancing and admission elements, then add
# them again. Counters, quotas and connection counts keep their values.
# Apply checks the table's ownership comment before running it, adds the
# state it records on the host and deletes the objects of removed hops in the
# same transaction. The anixops-hop and anixops-upstream lines are the
# manifest Apply reads: every rendered upstream, the bandwidth for tc.

# anixops-hop route=01JF1F000000000000000000F1 hop=0 mark=1 balance=BALANCE_STRATEGY_ROUND_ROBIN listen=tcp/40001 address=any bandwidth=0
# anixops-upstream route=01JF1F000000000000000000F1 hop=0 address=203.0.113.41 port=20000 weight=1 priority=0
# anixops-hop route=01JF1F000000000000000000F2 hop=0 mark=2 balance=BALANCE_STRATEGY_ROUND_ROBIN listen=tcp/40002 address=any bandwidth=0
# anixops-upstream route=01JF1F000000000000000000F2 hop=0 address=203.0.113.42 port=20000 weight=1 priority=0

table inet anixops_fwd {
	comment "anixops-forward-driver v1"
	counter r_01JF1F000000000000000000F1_h0_up {
	}
	counter r_01JF1F000000000000000000F1_h0_down {
	}
	map r_01JF1F000000000000000000F1_h0_lb4 {
		type mark : ipv4_addr . inet_service
		flags interval
	}
	counter r_01JF1F000000000000000000F2_h0_up {
	}
	counter r_01JF1F000000000000000000F2_h0_down {
	}
	map r_01JF1F000000000000000000F2_h0_lb4 {
		type mark : ipv4_addr . inet_service
		flags interval
	}
	chain r_01JF1F000000000000000000F1_h0_dnat {
	}
	chain r_01JF1F000000000000000000F1_h0_acct {
	}
	chain r_01JF1F000000000000000000F2_h0_dnat {
	}
	chain r_01JF1F000000000000000000F2_h0_acct {
	}
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
	}
	chain forward {
		type filter hook forward priority filter; policy accept;
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
	}
}

flush table inet anixops_fwd
flush map inet anixops_fwd r_01JF1F000000000000000000F1_h0_lb4
flush map inet anixops_fwd r_01JF1F000000000000000000F2_h0_lb4

table inet anixops_fwd {
	map r_01JF1F000000000000000000F1_h0_lb4 {
		type mark : ipv4_addr . inet_service
		flags interval
		elements = {
			0-127 : 203.0.113.41 . 20000,
		}
	}
	map r_01JF1F000000000000000000F2_h0_lb4 {
		type mark : ipv4_addr . inet_service
		flags interval
		elements = {
			0-127 : 203.0.113.42 . 20000,
		}
	}
	chain r_01JF1F000000000000000000F1_h0_dnat {
		ct mark set ct mark and 0xf000ffff or 0x00010000
		meta nfproto ipv4 meta l4proto tcp dnat ip to numgen inc mod 128 map @r_01JF1F000000000000000000F1_h0_lb4
		drop
	}
	chain r_01JF1F000000000000000000F1_h0_acct {
		ct direction original counter name "r_01JF1F000000000000000000F1_h0_up"
		ct direction reply counter name "r_01JF1F000000000000000000F1_h0_down"
	}
	chain r_01JF1F000000000000000000F2_h0_dnat {
		ct mark set ct mark and 0xf000ffff or 0x00020000
		meta nfproto ipv4 meta l4proto tcp dnat ip to numgen inc mod 128 map @r_01JF1F000000000000000000F2_h0_lb4
		drop
	}
	chain r_01JF1F000000000000000000F2_h0_acct {
		ct direction original counter name "r_01JF1F000000000000000000F2_h0_up"
		ct direction reply counter name "r_01JF1F000000000000000000F2_h0_down"
	}
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		tcp dport 40001 fib daddr type local goto r_01JF1F000000000000000000F1_h0_dnat
		tcp dport 40002 fib daddr type local goto r_01JF1F000000000000000000F2_h0_dnat
	}
	chain forward {
		type filter hook forward priority filter; policy accept;
		ct mark and 0x0fff0000 vmap {
			0x00010000 : jump r_01JF1F000000000000000000F1_h0_acct,
			0x00020000 : jump r_01JF1F000000000000000000F2_h0_acct,
		}
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ct mark and 0x0fff0000 {
			0x00010000,
			0x00020000,
		} masquerade
	}
}
