# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# Build artifacts
v2board
v2board.exe
v2board-linux
anix-control
anix-control.exe
anix-control-linux
*.exe

# Test artifacts
*.out
coverage.out
coverage.html
coverage/

# Development files
*.log
*.tmp
.env
.env.*

# Frontend dependencies and output (built inside the image)
web/node_modules
web/public
web/dist

# Data directories (should be mounted as volumes)
config/data/
logs/

# Documentation (the generated swagger package and specs are compiled in)
docs/
!docs/docs.go
!docs/swagger.json
!docs/swagger.yaml
*.md
!README.md
!config/deploy/ansible/README.md

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Test files
internal/tests/
*_test.go

# Config files, credentials and operator inventories never enter the image
config/config.yaml
config/config.prod.yaml
config/tls/
config/deploy/ssh/
config/deploy/**/inventory.ini
config/deploy/**/*.pem
config/deploy/**/*.key
**/*.env
secrets/

# Package build outputs and scratch space
packages/**/dist/
release-packages/
.tmp/

# Control Center app (separate module, built by control-center*.yml workflows)
control-center/
