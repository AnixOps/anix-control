{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnixOps signed package manifest",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "sha256"
      ],
      "properties": {
        "index": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "compatibilityRoutes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "api_version",
        "publisher",
        "targets",
        "architectures",
        "artifact_sha256",
        "capabilities",
        "dependencies",
        "conflicts",
        "permissions",
        "config_schema",
        "secret_fields",
        "entrypoints",
        "migration_version",
        "control_routes",
        "frontend_sha256",
        "webui"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "api_version": {"type": "string"},
        "publisher": {"const": "AnixOps"},
        "targets": {"type": "array", "minItems": 1, "items": {"enum": ["control", "agent"]}},
        "architectures": {"type": "array", "items": {"type": "string"}},
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "permissions": {"type": "array", "items": {"type": "string"}},
        "config_schema": {"type": "object"},
        "secret_fields": {"type": "array", "items": {"type": "string"}},
        "entrypoints": {"type": "object", "additionalProperties": {"type": "string"}},
        "migration_version": {"type": "integer", "minimum": 0},
        "control_routes": {"type": "array", "items": {"type": "string"}},
        "frontend_sha256": {"$ref": "#/$defs/digest"},
        "webui": {"type": "object"}
      }
    },
    "v1": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"api_version": {"const": "v1"}}}
      ]
    },
    "v2": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "required": [
            "control_entrypoint",
            "migrations",
            "compatibility_routes",
            "route_contract_digest"
          ],
          "properties": {
            "api_version": {"const": "v2"},
            "control_entrypoint": {"$ref": "#/$defs/file"},
            "agent_entrypoint": {"oneOf": [{"$ref": "#/$defs/file"}, {"type": "null"}]},
            "migrations": {"$ref": "#/$defs/migrations"},
            "compatibility_routes": {"$ref": "#/$defs/compatibilityRoutes"},
            "route_contract_digest": {"$ref": "#/$defs/digest"},
            "runtime_api_version": {"type": "string"}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "targets": {"contains": {"const": "agent"}}
                },
                "required": ["targets"]
              },
              "then": {
                "required": ["agent_entrypoint", "runtime_api_version"]
              }
            }
          ]
        }
      ]
    }
  }
}
