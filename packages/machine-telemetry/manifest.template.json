{
  "id": "machine-telemetry",
  "name": "Machine Telemetry",
  "version": "4.0.0",
  "api_version": "v2",
  "publisher": "AnixOps",
  "targets": [
    "control",
    "agent"
  ],
  "architectures": [],
  "artifact_sha256": "__ARTIFACT_SHA256__",
  "capabilities": [
    "telemetry.read",
    "telemetry.systemd.read",
    "kernel.storage.v1",
    "kernel.view:kapi_traffic_log_v1",
    "kernel.view:kapi_user_directory_v1",
    "kernel.view:kapi_package_report_v1",
    "kernel.view:kapi_plugin_configuration_v1",
    "kernel.telemetry.dashboard.v1"
  ],
  "dependencies": [],
  "conflicts": [],
  "permissions": [
    "machine-telemetry.view",
    "machine-telemetry.api",
    "machine-telemetry.services.view"
  ],
  "config_schema": {
    "$id": "urn:anixops:plugin:machine-telemetry:config:v2",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "interval_seconds": {
        "default": 30,
        "maximum": 3600,
        "minimum": 5,
        "type": "integer"
      },
      "systemd_services": {
        "additionalProperties": false,
        "description": "Per-node systemd services table (read-only). Off on every node until enabled here.",
        "properties": {
          "nodes": {
            "type": "object",
            "maxProperties": 4096,
            "propertyNames": {
              "pattern": "^[1-9][0-9]{0,9}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "include": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9:_.\\\\@*?\\[\\]^-]+$"
                  }
                },
                "exclude": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9:_.\\\\@*?\\[\\]^-]+$"
                  }
                }
              }
            }
          }
        },
        "type": "object"
      }
    },
    "title": "Machine Telemetry Configuration",
    "type": "object"
  },
  "secret_fields": [],
  "entrypoints": {},
  "migration_version": 1,
  "control_routes": [
    "/api/v3/plugins/machine-telemetry/status",
    "/api/v3/plugins/machine-telemetry/nodes/*"
  ],
  "frontend_sha256": "__WEBUI_SHA256__",
  "webui": {
    "bundle": {
      "path": "webui/index.mjs",
      "sha256": "__WEBUI_SHA256__"
    },
    "permissions": [
      "machine-telemetry.view"
    ],
    "menus": [
      {
        "id": "machine-telemetry.main",
        "parent": "operations",
        "label": "Machine Telemetry",
        "icon": "activity",
        "route": "/admin/extensions/machine-telemetry",
        "permission": "machine-telemetry.view",
        "order": 100
      }
    ],
    "routes": [
      {
        "id": "machine-telemetry.main",
        "path": "/admin/extensions/machine-telemetry",
        "export": "default",
        "permission": "machine-telemetry.view"
      }
    ]
  },
  "control_entrypoint": {
    "path": "bin/control-host",
    "sha256": "GENERATED_AT_BUILD"
  },
  "agent_entrypoint": {
    "path": "agent/linux-amd64/plugin",
    "sha256": "GENERATED_AT_BUILD"
  },
  "migrations": {
    "index": "migrations/index.json",
    "sha256": "GENERATED_AT_BUILD"
  },
  "compatibility_routes": {
    "path": "compat/v2-routes.json",
    "sha256": "GENERATED_AT_BUILD"
  },
  "route_contract_digest": "GENERATED_AT_BUILD",
  "runtime_api_version": "anixops.agent.sdk/v1.1.0"
}
