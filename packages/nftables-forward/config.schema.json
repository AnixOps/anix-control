{
  "$id": "urn:anixops:plugin:nftables-forward:config:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apply": {
      "default": false,
      "type": "boolean"
    },
    "chain": {
      "default": "prerouting",
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "family": {
      "default": "inet",
      "enum": [
        "inet",
        "ip",
        "ip6"
      ],
      "type": "string"
    },
    "nft_binary": {
      "default": "nft",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\u0000\\r\\n]+$",
      "type": "string"
    },
    "plan_path": {
      "default": "",
      "maxLength": 4096,
      "pattern": "^$|^/",
      "type": "string"
    },
    "priority": {
      "default": -100,
      "maximum": 500,
      "minimum": -500,
      "type": "integer"
    },
    "rollback_on_exit": {
      "const": true,
      "default": true,
      "type": "boolean"
    },
    "rules": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "default": "",
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9 ._:/@+-]*$",
            "type": "string"
          },
          "id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "type": "string"
          },
          "listen_address": {
            "maxLength": 45,
            "minLength": 2,
            "type": "string"
          },
          "listen_port": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "protocol": {
            "enum": [
              "tcp",
              "udp"
            ],
            "type": "string"
          },
          "target_address": {
            "maxLength": 45,
            "minLength": 2,
            "type": "string"
          },
          "target_port": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "protocol",
          "listen_address",
          "listen_port",
          "target_address",
          "target_port"
        ],
        "type": "object"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "table": {
      "default": "anixops_forward",
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    }
  },
  "required": [
    "apply",
    "nft_binary",
    "plan_path",
    "family",
    "table",
    "chain",
    "priority",
    "rollback_on_exit",
    "rules"
  ],
  "title": "nftables Forward Configuration",
  "type": "object"
}
